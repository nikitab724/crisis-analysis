# Required only for the live model service. Never commit the real .env file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-with-your-server-side-key
# Optional for scripts/run_pipeline.py: demo runs the known post with real NLP/DB.
# Use live to additionally start Bluesky ingestion. See docs/BACKEND.md.
CRISIS_PIPELINE_MODE=demo
# Optional persistent local ingestion queue. Defaults to .demo-live/ingest in this repo.
# Use one collector/processor per directory; keep it on a persistent local disk.
# CRISIS_INGEST_DIR=/absolute/path/to/ingest
# Optional Jev location selection + relevance screening. Off needs no API key.
CRISIS_RELEVANCE_MODE=off
# Optional semantic crisis classification. Keep rules for the original demo.
# jev also requires CRISIS_RELEVANCE_MODE=jev; see docs/JEV_CLASSIFICATION.md.
CRISIS_CLASSIFICATION_MODE=rules
# In live Jev mode: broad candidate wording keeps unrelated posts off the transformer.
# all analyzes every post; use only for bounded evaluations, not the full firehose.
CRISIS_CANDIDATE_FILTER=expanded
# Optional batched semantic screening before NLP; clear negatives alone are skipped.
JEV_BATCH_SCREEN=off
AI_GATEWAY_API_KEY=
JEV_MIN_PROBABILITY=0.8
# 0 disables the per-process request cap; provider limits and cooldown still apply.
JEV_MAX_CALLS_PER_RUN=200
# Minimum seconds between request starts across workers; increases after 429/503.
JEV_MIN_REQUEST_INTERVAL=1
# Live processing: bounded concurrency and one shared transformer.
CRISIS_PROCESSING_WORKERS=4
CRISIS_BATCH_SIZE=100

# Optional Render Free gateway to the Mac's public dashboard. HTTPS origin only.
# Leave empty for the independent sample replay. Set this in Render, not the Mac pipeline.
LIVE_DASHBOARD_URL=
# Optional real test-post box in the sample dashboard. Same server-only secret on
# Render and the Mac; generate at least 32 random characters. Never expose to JS.
CRISIS_TEST_API_TOKEN=
# Enable only on the Mac dashboard serving the existing model pipeline.
CRISIS_TEST_BACKEND=0
